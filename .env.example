# ============================================
# Variables de Entorno - Product Purchasing System
# ============================================
#
# Archivo de ejemplo seguro para Git.
# Usar como plantilla base para ambientes controlados.
#

# ============================================
# Configuración de Base de Datos
# ============================================

DB_HOST=your-production-db-host
DB_PORT=3306
DB_NAME=your_production_database
DB_USER=your_production_user
DB_PASSWORD=CHANGE_ME_PRODUCTION_SECRET

# ============================================
# Configuración Hibernate / JPA
# ============================================

# Producción recomendada: none
# Desarrollo controlado: update
DB_DDL_AUTO=none

# Producción recomendada: false
DB_SHOW_SQL=false

# Pool Hikari
DB_POOL_SIZE=10

# ============================================
# Configuración de Aplicación
# ============================================

APP_ENVIRONMENT=production

# ============================================
# Logging
# ============================================

LOG_LEVEL=INFO
LOG_SQL_LEVEL=WARN
LOG_SQL_BIND_LEVEL=OFF

# Perfil opcional Spring
# SPRING_PROFILES_ACTIVE=prod
